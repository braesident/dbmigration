{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "migration.schema.json",
  "title": "DbMigration JSON",
  "description": "Schema für Migrationen (up/down) mit Builder-Definitionen oder direkten Dialekt-SQLs (mysql/sqlsrv).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {},
    "up": {
      "$ref": "#/$defs/steps",
      "minItems": 1
    },
    "down": {
      "$ref": "#/$defs/steps"
    }
  },
  "required": [
    "up",
    "down"
  ],
  "$defs": {
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/builderStep"
        },
        {
          "$ref": "#/$defs/dialectStep"
        }
      ]
    },
    "builderStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "builder": {
          "type": "string",
          "enum": [
            "sql",
            "sqlbuilder"
          ]
        },
        "definition": {
          "$ref": "#/$defs/definition"
        }
      },
      "required": [
        "builder",
        "definition"
      ]
    },
    "dialectStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mysql": {
          "$ref": "#/$defs/sqlString"
        },
        "sqlsrv": {
          "$ref": "#/$defs/sqlString"
        },
        "sql": {
          "$ref": "#/$defs/sqlString"
        },
        "default": {
          "$ref": "#/$defs/sqlString"
        }
      },
      "minProperties": 1
    },
    "definition": {
      "oneOf": [
        {
          "$ref": "#/$defs/createTableDefinition"
        },
        {
          "$ref": "#/$defs/dropTableDefinition"
        },
        {
          "$ref": "#/$defs/alterTableDefinition"
        },
        {
          "$ref": "#/$defs/rawDefinition"
        }
      ]
    },
    "rawDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "raw"
        },
        "mysql": {
          "$ref": "#/$defs/sqlString"
        },
        "sqlsrv": {
          "$ref": "#/$defs/sqlString"
        },
        "sql": {
          "$ref": "#/$defs/sqlString"
        },
        "default": {
          "$ref": "#/$defs/sqlString"
        }
      },
      "required": [
        "type"
      ],
      "minProperties": 2
    },
    "createTableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "create_table"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "ifNotExists": {
          "type": "boolean"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "primaryKey": {
          "$ref": "#/$defs/columnList"
        },
        "unique": {
          "$ref": "#/$defs/uniqueList"
        },
        "indexes": {
          "$ref": "#/$defs/indexList"
        },
        "foreignKeys": {
          "$ref": "#/$defs/foreignKeyList"
        },
        "checks": {
          "$ref": "#/$defs/checkList"
        }
      },
      "required": [
        "type",
        "table",
        "columns"
      ]
    },
    "dropTableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "drop_table"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "ifExists": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "table"
      ]
    },
    "alterTableDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "alter_table"
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "actions": {
          "$ref": "#/$defs/alterActions"
        }
      },
      "required": [
        "type",
        "table",
        "actions"
      ]
    },
    "alterActions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/alterAction"
      }
    },
    "alterAction": {
      "oneOf": [
        {
          "$ref": "#/$defs/addColumnAction"
        },
        {
          "$ref": "#/$defs/modifyColumnAction"
        },
        {
          "$ref": "#/$defs/dropColumnAction"
        },
        {
          "$ref": "#/$defs/renameColumnAction"
        },
        {
          "$ref": "#/$defs/renameTableAction"
        },
        {
          "$ref": "#/$defs/addIndexAction"
        },
        {
          "$ref": "#/$defs/dropIndexAction"
        },
        {
          "$ref": "#/$defs/addUniqueAction"
        },
        {
          "$ref": "#/$defs/dropUniqueAction"
        },
        {
          "$ref": "#/$defs/addCheckAction"
        },
        {
          "$ref": "#/$defs/dropCheckAction"
        },
        {
          "$ref": "#/$defs/addPrimaryKeyAction"
        },
        {
          "$ref": "#/$defs/dropPrimaryKeyAction"
        },
        {
          "$ref": "#/$defs/addForeignKeyAction"
        },
        {
          "$ref": "#/$defs/dropForeignKeyAction"
        }
      ]
    },
    "addColumnAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_column"
        },
        "column": {
          "$ref": "#/$defs/column"
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "first": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "column"
      ]
    },
    "modifyColumnAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "modify_column"
        },
        "column": {
          "$ref": "#/$defs/column"
        },
        "after": {
          "type": "string",
          "minLength": 1
        },
        "first": {
          "type": "boolean"
        }
      },
      "required": [
        "action",
        "column"
      ]
    },
    "dropColumnAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_column"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "name"
      ]
    },
    "renameColumnAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "rename_column"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "$ref": "#/$defs/column"
        }
      },
      "required": [
        "action",
        "from",
        "to"
      ]
    },
    "renameTableAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "rename_table"
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "to"
      ]
    },
    "addIndexAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_index"
        },
        "index": {
          "$ref": "#/$defs/indexDefinition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": [
            "index"
          ]
        },
        {
          "required": [
            "columns"
          ]
        }
      ]
    },
    "dropIndexAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_index"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "name"
      ]
    },
    "addUniqueAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_unique"
        },
        "unique": {
          "$ref": "#/$defs/uniqueDefinition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": [
            "unique"
          ]
        },
        {
          "required": [
            "columns"
          ]
        }
      ]
    },
    "dropUniqueAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_unique"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "name"
      ]
    },
    "addCheckAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_check"
        },
        "check": {
          "$ref": "#/$defs/checkDefinition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": [
            "check"
          ]
        },
        {
          "required": [
            "expression"
          ]
        }
      ]
    },
    "dropCheckAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_check"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "name"
      ]
    },
    "addPrimaryKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_primary_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        }
      },
      "required": [
        "action",
        "columns"
      ]
    },
    "dropPrimaryKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_primary_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action"
      ]
    },
    "addForeignKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_foreign_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        },
        "refTable": {
          "type": "string",
          "minLength": 1
        },
        "refColumns": {
          "$ref": "#/$defs/columnList"
        },
        "onDelete": {
          "type": "string"
        },
        "onUpdate": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "columns",
        "refTable",
        "refColumns"
      ]
    },
    "dropForeignKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_foreign_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "name"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "length": {
          "type": "integer",
          "minimum": 1
        },
        "precision": {
          "type": "integer",
          "minimum": 1
        },
        "scale": {
          "type": "integer",
          "minimum": 0
        },
        "nullable": {
          "type": "boolean"
        },
        "default": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "onUpdate": {
          "type": "string"
        },
        "unsigned": {
          "type": "boolean"
        },
        "autoIncrement": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "raw": {
          "$ref": "#/$defs/sqlString"
        },
        "mysql": {
          "$ref": "#/$defs/sqlString"
        },
        "sqlsrv": {
          "$ref": "#/$defs/sqlString"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "columnList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uniqueList": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/columnList"
          },
          {
            "$ref": "#/$defs/uniqueDefinition"
          }
        ]
      }
    },
    "uniqueDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        }
      },
      "required": [
        "columns"
      ]
    },
    "indexList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/indexDefinition"
      }
    },
    "indexDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        }
      },
      "required": [
        "columns"
      ]
    },
    "foreignKeyList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/foreignKeyDefinition"
      }
    },
    "foreignKeyDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        },
        "refTable": {
          "type": "string",
          "minLength": 1
        },
        "refColumns": {
          "$ref": "#/$defs/columnList"
        },
        "onDelete": {
          "$ref": "#/$defs/fkAction"
        },
        "onUpdate": {
          "$ref": "#/$defs/fkAction"
        }
      },
      "required": [
        "columns",
        "refTable",
        "refColumns"
      ]
    },
    "checkList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkDefinition"
      }
    },
    "checkDefinition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expression"
      ]
    },
    "fkAction": {
      "type": "string",
      "minLength": 1
    },
    "sqlString": {
      "type": "string",
      "minLength": 1
    }
  }
}

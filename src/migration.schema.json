            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        },
        "onUpdate": {
          "type": "string"
        },
        "unsigned": {
          "type": "boolean"
        },
        "autoIncrement": {
          "type": "boolean"
        },
        "identity": {
          "type": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "raw": {
          "$ref": "#/$defs/sqlString"
        },
        "mysql": {
          "$ref": "#/$defs/sqlString"
        },
        "sqlsrv": {
          "$ref": "#/$defs/sqlString"
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "columnList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "uniqueList": {
      "type": "array",

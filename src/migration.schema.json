      ]
    },
    "addCheckAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_check"
        },
        "check": {
          "$ref": "#/$defs/checkDefinition"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action"
      ],
      "oneOf": [
        {
          "required": [
            "check"
          ]
        },
        {
          "required": [
            "expression"
          ]
        }
      ]
    },
    "dropCheckAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_check"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action",
        "name"
      ]
    },
    "addPrimaryKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_primary_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        }
      },
      "required": [
        "action",
        "columns"
      ]
    },
    "dropPrimaryKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_primary_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "action"
      ]
    },
    "addForeignKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "add_foreign_key"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "$ref": "#/$defs/columnList"
        },
        "refTable": {
          "type": "string",
          "minLength": 1
        },
        "refColumns": {
          "$ref": "#/$defs/columnList"
        },
        "onDelete": {
          "type": "string"
        },
        "onUpdate": {
          "type": "string"
        }
      },
      "required": [
        "action",
        "columns",
        "refTable",
        "refColumns"
      ]
    },
    "dropForeignKeyAction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "const": "drop_foreign_key"
